$bog_klik_bench $mol_page
	title @ \Нагрузка
	store $bog_klik_store
	bots_count? 10
	bot_tick_ms? 1000
	bot_per_tick? 1
	running? false
	body /
		<= Params $mol_list rows /
			<= Count_row $mol_row sub /
				<= Count_label $mol_paragraph title @ \Количество ботов
				<= Count_field $mol_number
					hint @ \Количество ботов
					value? <=> bots_count? 10
			<= Tick_row $mol_row sub /
				<= Tick_label $mol_paragraph title @ \Интервал тика, мс
				<= Tick_field $mol_number
					hint @ \Мс между записями
					value? <=> bot_tick_ms? 1000
			<= Per_row $mol_row sub /
				<= Per_label $mol_paragraph title @ \Записей за тик на бота
				<= Per_field $mol_number
					hint @ \Сколько +1 к Score за тик
					value? <=> bot_per_tick? 1
		<= Toggle $mol_check
			checked? <=> running? false
			label / \Запустить
		<= Metrics $mol_list rows /
			<= Ops $mol_paragraph title <= ops_title \Записей/с: 0
			<= Writes $mol_paragraph title <= writes_title \Всего записей: 0
			<= Latency $mol_paragraph title <= latency_title \Длительность тика, мс: 0
